# TradePulse — copy to .env (git-ignored) and fill in.
# The backend reads these from the environment; nothing here is baked into the
# frontend bundle, and the Kite secret must never reach the browser.

# --- Zerodha Kite Connect -------------------------------------------------
# From https://developers.kite.trade/apps — leave both blank to run the local
# stub, which exercises the whole redirect flow without a real Zerodha app.
KITE_API_KEY=
KITE_API_SECRET=

# Must match the redirect URL registered on the Kite developer console exactly.
# In dev the browser talks to Vite (5273), which proxies /api to the backend.
KITE_REDIRECT_URL=http://127.0.0.1:5273/api/kite/callback

# --- Login ----------------------------------------------------------------
# The app's own lock, separate from the broker connection. Required by
# default. Leave PASSCODE blank and the backend prints a one-time passcode at
# startup rather than running open; set it to choose your own.
#   python -c "import secrets; print(secrets.token_urlsafe(12))"
TRADEPULSE_PASSCODE=
TRADEPULSE_USER_NAME=Investor
# Only ever set this to false on a machine nobody else can reach.
TRADEPULSE_AUTH_REQUIRED=true

# --- AI chat --------------------------------------------------------------
# The "Ask AI" drawer on signals and opportunities. Calls are made by the
# backend, so this key is never in the browser. Leave blank and the drawer
# says the server has no model configured instead of failing.
ANTHROPIC_API_KEY=
TRADEPULSE_AI_MODEL=claude-opus-5

# --- Quotes without a broker ----------------------------------------------
# Any JSON quote endpoint. {symbol} is substituted into the URL; the paths are
# dotted into the response ("data.{symbol}.last", "quotes.0.price"). Unset
# means deterministic stub quotes, labelled as such on every screen — they
# may fill a price nobody supplied, never overwrite one somebody did.
TRADEPULSE_QUOTES_URL=
TRADEPULSE_QUOTES_PRICE_PATH=price
TRADEPULSE_QUOTES_CHANGE_PATH=
# e.g. "Authorization: Bearer <token>" or "X-Api-Key: <key>"
TRADEPULSE_QUOTES_AUTH_HEADER=

# --- Backend --------------------------------------------------------------
TRADEPULSE_HOST=127.0.0.1
TRADEPULSE_PORT=8787

# Where the OAuth callback sends the browser once a session exists.
TRADEPULSE_FRONTEND_URL=http://127.0.0.1:5273/

# Session cookie. SECURE defaults to true unless FRONTEND_URL is this machine
# (localhost / 127.0.0.1); serve over HTTPS anywhere else.
TRADEPULSE_COOKIE_NAME=tradepulse_session
TRADEPULSE_COOKIE_SECURE=
TRADEPULSE_COOKIE_SAMESITE=lax

# Where sessions and generated secrets live. Login and broker sessions are in
# an owner-only SQLite file here, so a restart no longer logs everyone out.
TRADEPULSE_DATA_DIR=data
TRADEPULSE_SESSIONS_DB=data/sessions.db

# Signs the OAuth state nonce. Leave blank and one is generated on first run
# and kept in TRADEPULSE_DATA_DIR/state_secret, so restarts and extra workers
# agree. Set it explicitly to share across hosts.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TRADEPULSE_STATE_SECRET=

# --- Intelligence layer ---------------------------------------------------
# Recommendation history, valuations and learned weights live here. A relative
# path resolves against the server directory. Use ":memory:" only for throwaway
# runs — the performance and learning loops need history to mean anything.
TRADEPULSE_INTEL_DB=data/tradepulse.db

# How often the orchestrator runs a full cycle, in seconds. 0 disables the
# scheduler entirely and leaves POST /api/intel/run as the only trigger.
TRADEPULSE_CYCLE_SECONDS=900

# --- Frontend dev server --------------------------------------------------
# Where Vite proxies /api. Only needed if the backend isn't on the default.
TRADEPULSE_API_URL=http://127.0.0.1:8787
